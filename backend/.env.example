# Twelve-factor: every knob is an env var, validated at boot by src/config/env.ts.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

DATABASE_URL=postgres://lumi:lumi@localhost:5432/lumi
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379

# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Cloudflare R2 (S3 compatible). Leave empty to disable media uploads.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=

# Leave empty to use the deterministic stub provider.
AI_PROVIDER_API_KEY=
AI_MODEL=gpt-4o-mini

# RevenueCat webhook shared secret. Empty disables the webhook route.
BILLING_WEBHOOK_SECRET=

SENTRY_DSN=

# How far from an occupied cell a new object may appear.
SURFACE_SPAWN_RADIUS=2
# Fading -> Settled after this many hours.
SURFACE_AGE_AFTER_HOURS=72
