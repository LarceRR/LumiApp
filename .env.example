# iOS simulator
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/v1
EXPO_PUBLIC_WEBSOCKET_URL=ws://localhost:3000/realtime

# Android emulator:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000/v1
# EXPO_PUBLIC_WEBSOCKET_URL=ws://10.0.2.2:3000/realtime

# Physical device: replace with your computer LAN address, e.g. 192.168.1.10
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000/v1
# EXPO_PUBLIC_WEBSOCKET_URL=ws://192.168.1.10:3000/realtime
